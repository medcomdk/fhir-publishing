{
  "name": "fhir-ig-firely-validator",
  "displayName": "MedCom Firely Validation",
  "description": "Quick Firely Terminal validation or Firely .NET SDK validation with an optional _genonce.sh rebuild.",
  "icon": "fire-in-pizza-oven_1.jpg",
  "version": "1.1.0",
  "publisher": "MedComPublisher",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/medcomdk/fhir-publishing.git",
    "directory": "firely-validation-vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "FHIR",
    "SUSHI",
    "Firely",
    "validation"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Validation runs SUSHI, Firely Terminal, IG Publisher, and the Firely .NET SDK in the implementation guide directory."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "fhirIg.validate",
        "title": "MedCom Firely Validation: Build and Validate",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "fhirIg.validateSdk",
        "title": "MedCom Firely Validation: Validate with SDK",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "fhirIg.validate",
          "when": "resourceFilename == sushi-config.yaml || resourceFilename == sushi-config.yml",
          "group": "navigation"
        },
        {
          "command": "fhirIg.validateSdk",
          "when": "resourceFilename == sushi-config.yaml || resourceFilename == sushi-config.yml",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MedCom Firely Validation",
      "properties": {
        "fhirIg.sushiPath": {
          "type": "string",
          "default": "sushi",
          "scope": "machine-overridable",
          "description": "SUSHI executable name or absolute path (without arguments)."
        },
        "fhirIg.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "scope": "machine-overridable",
          "description": ".NET SDK executable name or absolute path (without arguments)."
        },
        "fhirIg.terminologyServer": {
          "type": "string",
          "default": "https://tx.hl7europe.eu/r4",
          "scope": "resource",
          "description": "FHIR R4 terminology server used when local terminology cannot validate a code."
        },
        "fhirIg.firelyPath": {
          "type": "string",
          "default": "fhir",
          "scope": "machine-overridable",
          "description": "Firely Terminal executable for quick validation (without arguments)."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "node test/integration.js",
    "prepackage": "node scripts/check-node.js",
    "package": "vsce package --skip-license"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
