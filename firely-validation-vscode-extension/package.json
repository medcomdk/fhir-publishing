{
  "name": "fhir-ig-firely-validator",
  "displayName": "MedCom Firely Validation",
  "description": "Firely validation and live narrative preview for FHIR implementation guides.",
  "icon": "fire-in-pizza-oven_1.jpg",
  "version": "1.2.3",
  "publisher": "MedComPublisher",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/medcomdk/fhir-publishing.git",
    "directory": "firely-validation-vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "FHIR",
    "SUSHI",
    "Firely",
    "validation",
    "preview",
    "Jekyll"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Validation and live preview run local tools, including IG Publisher and Jekyll, in the implementation guide directory."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "fhirIg.validate",
        "title": "MedCom Firely Validation: Build and Validate",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "fhirIg.validateSdk",
        "title": "MedCom Firely Validation: Validate with SDK",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "fhirIg.startPreview",
        "title": "MedCom IG Preview: Start Live Preview",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "fhirIg.stopPreview",
        "title": "MedCom IG Preview: Stop Live Preview"
      },
      {
        "command": "fhirIg.openPreview",
        "title": "MedCom IG Preview: Open Live Preview",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "fhirIg.startPreview",
          "when": "!fhirIg.previewActive && (resourceFilename == sushi-config.yaml || resourceFilename == sushi-config.yml)",
          "group": "navigation"
        },
        {
          "command": "fhirIg.stopPreview",
          "when": "fhirIg.previewActive && (resourceFilename == sushi-config.yaml || resourceFilename == sushi-config.yml)",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "fhirIg.startPreview",
          "when": "!fhirIg.previewActive && (resourceFilename == sushi-config.yaml || resourceFilename == sushi-config.yml)",
          "group": "navigation"
        },
        {
          "command": "fhirIg.stopPreview",
          "when": "fhirIg.previewActive && (resourceFilename == sushi-config.yaml || resourceFilename == sushi-config.yml)",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "fhirIg.validate",
          "when": "resourceFilename == sushi-config.yaml || resourceFilename == sushi-config.yml",
          "group": "navigation"
        },
        {
          "command": "fhirIg.validateSdk",
          "when": "resourceFilename == sushi-config.yaml || resourceFilename == sushi-config.yml",
          "group": "navigation"
        },
        {
          "command": "fhirIg.startPreview",
          "when": "!fhirIg.previewActive && (resourceFilename == sushi-config.yaml || resourceFilename == sushi-config.yml)",
          "group": "navigation"
        },
        {
          "command": "fhirIg.stopPreview",
          "when": "fhirIg.previewActive && (resourceFilename == sushi-config.yaml || resourceFilename == sushi-config.yml)",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MedCom Firely Validation",
      "properties": {
        "fhirIg.sushiPath": {
          "type": "string",
          "default": "sushi",
          "scope": "machine-overridable",
          "description": "SUSHI executable name or absolute path (without arguments)."
        },
        "fhirIg.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "scope": "machine-overridable",
          "description": ".NET SDK executable name or absolute path (without arguments)."
        },
        "fhirIg.terminologyServer": {
          "type": "string",
          "default": "https://tx.hl7europe.eu/r4",
          "scope": "resource",
          "description": "FHIR R4 terminology server used when local terminology cannot validate a code."
        },
        "fhirIg.firelyPath": {
          "type": "string",
          "default": "fhir",
          "scope": "machine-overridable",
          "description": "Firely Terminal executable for quick validation (without arguments)."
        },
        "fhirIg.preview.jekyllPath": {
          "type": "string",
          "default": "jekyll",
          "scope": "machine-overridable",
          "description": "Jekyll executable name or absolute path (without arguments). The default uses the managed preview installation when available; otherwise the extension offers to install Ruby/Jekyll when missing."
        },
        "fhirIg.preview.port": {
          "type": "integer",
          "default": 4000,
          "minimum": 1,
          "maximum": 65535,
          "scope": "resource",
          "description": "Live preview HTTP port. The adjacent port is used for LiveReload and must also be available."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "node test/integration.js",
    "prepackage": "node scripts/check-node.js",
    "package": "vsce package --skip-license"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
